package com.tap;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

import javax.servlet.ServletException;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

//username, email, address
public class Servlet1 extends HttpServlet{
	
	private static final String url ="jdbc:mysql://localhost:3306/registrationdb";
	private static final String uname ="root";
	private static final String upass ="root";
	private static final String pkg ="com.mysql.cj.jdbc.Driver";
	private static final String INSERT_QUERY ="INSERT INTO `list` (`username`,`email`,`address`) VALUES (?,?,?)";
	
	 Connection con = null;
	 PreparedStatement pstmt = null;
	
	@Override
	protected void service(HttpServletRequest req, HttpServletResponse resp) throws ServletException, IOException {
		
		resp.setContentType("text/html");
		
		try {
			Class.forName(pkg);
			con = DriverManager.getConnection(url, uname, upass);
			
			pstmt = con.prepareStatement(INSERT_QUERY);
			
			String uname = req.getParameter("username");
			String email = req.getParameter("emailid");
			String add = req.getParameter("address");
			
			pstmt.setString(1, uname);
			pstmt.setString(2, email);
			pstmt.setString(3, add);
			
			int row = pstmt.executeUpdate();
			
			PrintWriter pw = resp.getWriter();
			
			if(row>0)
			{
				pw.print("REGISTRATION SUCCESSFULL");
			}
			else
			{
				pw.print("REGISTARTION FAILED");
			}
			
		} catch (ClassNotFoundException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			 PrintWriter pw = resp.getWriter();
			    pw.print("Driver Error: " + e.getMessage());
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			PrintWriter pw = resp.getWriter();
		    pw.print("SQL Error: " + e.getMessage());
		}
	}
